'''
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

'''

class Solution:
    def length(self, head):
        curr = head
        ans = 0
        while curr:
            ans += 1
            curr = curr.next
        return ans
        
        
    def intersectPoint(self, head1, head2):
        # code here
        l1, l2 = self.length(head1), self.length(head2)
        if (l1 > l2):
            curr1, curr2 = head1, head2
            diff = 0
            while (diff != (l1 - l2)):
                curr1 = curr1.next
                diff += 1
        
            while (curr1 and curr2):
                if curr1 == curr2:
                    return curr1
                curr1 = curr1.next
                curr2 = curr2.next
            return -1
        else:
            curr1, curr2 = head1, head2
            diff = 0
            while (diff != (l2 - l1)):
                curr2 = curr2.next
                diff += 1
        
            while (curr1 and curr2):
                if curr1 == curr2:
                    return curr1
                curr1 = curr1.next
                curr2 = curr2.next
            return -1
