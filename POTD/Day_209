class Solution:
    def subsetXOR(self, n : int):
        # code here
        from functools import reduce
        from operator import xor
        acc = reduce(xor, range(1, n+1))
        if acc == n:
            return list(range(1, n+1))
            
        # actually, it is guranteed that subset should have n-1 elements if (xor 1..n) doesn't equal to n
        # say, we want to have 1 xor 2 xor ... missing-x-here xor n = n
        # then we xor missing-x on both side the equation
        # left = 1 xor 2 ... n and right = missing-x xor n
        # => missing-x = acc xor n. we even determine the missing-x
        missing_x = acc ^ n
        return [e for e in range(1, n+1) if e != missing_x]
