class Solution:
    def isInterleave(self, s1, s2, s3):
        # code here
        if len(s1)+len(s2)!=len(s3):
            return False
        def function(i,j,k):
            if k==len(s3):
                return i==len(s1) and j==len(s2)
            if i<len(s1) and s1[i]==s3[k]:
                if function(i+1,j,k+1):
                    return True
            if j<len(s2) and s2[j]==s3[k]:
                if function(i,j+1,k+1):
                    return True
            return False
        return function(0,0,0)
