     # code here
        n = len(arr)
        dp = [[[None]*2 for _ in range(n)] for _ in range(n)]
        
        for i in range(n-1, -1, -1):
            for j in range(i, n):
                if i == j:
                    dp[i][j][0] = arr[i]
                    dp[i][j][1] = 0
                else:
                    if arr[i] + dp[i+1][j][1] > arr[j] + dp[i][j-1][1]:
                        dp[i][j][0] = arr[i] + dp[i+1][j][1]
                        dp[i][j][1] = dp[i+1][j][0]
                    else:
                        dp[i][j][0] = arr[j] + dp[i][j-1][1]
                        dp[i][j][1] = dp[i][j-1][0]
        return dp[0][-1][0]
