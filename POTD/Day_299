  def noOfWays(self, m,n,x):
        # code here
        dp = [[0]*(n+1) for _ in range(x+1)]
        dp[0][0] = 1
        for t in range(1, x+1):
            for i in range(1, n+1):
                for v in range(1, m+1):
                    if t-v < 0:
                        break
                    dp[t][i] += dp[t-v][i-1]
        return dp[-1][-1]
