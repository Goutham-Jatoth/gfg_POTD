def josephus(self, n, k):
        if k == 2:
            # https://en.wikipedia.org/wiki/Josephus_problem#k_=_2
            i = n.bit_length()
            msb = 1 << i - 1
            return 2 * (n ^ msb) + 1
        
        # https://en.wikipedia.org/wiki/Josephus_problem#The_general_case
        def dfs(n, k):
            if n == 1:
                return 0
            return (dfs(n - 1, k) + k) % n
            
        return dfs(n, k) + 1
