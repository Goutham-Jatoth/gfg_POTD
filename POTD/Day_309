class Solution:
    def largestBst(self, root):
        
        self.maxSize = 0
        
        def solve(node):
            # Base case
            if not node:
                return (float('inf'), float('-inf'), 0, True)
            
            left_min, left_max, left_size, left_isBST = solve(node.left)
            right_min, right_max, right_size, right_isBST = solve(node.right)
            
            # Check if current subtree is BST
            if left_isBST and right_isBST and left_max < node.data < right_min:
                
                curr_size = left_size + right_size + 1
                self.maxSize = max(self.maxSize, curr_size)
                
                return (
                    min(node.data, left_min),
                    max(node.data, right_max),
                    curr_size,
                    True
                )
            
            # If not BST
            return (0, 0, 0, False)
        
        solve(root)
        return self.maxSize

